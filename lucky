<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Lucky Tours</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family: Arial, sans-serif;
}

body{
    background:#f4f4f4;
    color:#333;
}

/* HERO SECTION */
.hero{
    height:100vh;
    background:
    linear-gradient(rgba(0,0,0,0.5),rgba(0,0,0,0.5)),
    url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=1600&auto=format&fit=crop');
    background-size:cover;
    background-position:center;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    color:#fff;
    padding:20px;
}

.hero-content h1{
    font-size:60px;
    margin-bottom:10px;
    color:#00ffae;
}

.hero-content h2{
    font-size:28px;
    margin-bottom:20px;
}

.hero-content p{
    font-size:20px;
    line-height:1.8;
}

.btn{
    display:inline-block;
    margin-top:25px;
    padding:15px 35px;
    background:#00c27a;
    color:#fff;
    text-decoration:none;
    border-radius:40px;
    font-size:20px;
    transition:0.3s;
}

.btn:hover{
    background:#00995f;
    transform:scale(1.05);
}

/* SERVICES */
.services{
    padding:70px 20px;
    background:#fff;
    text-align:center;
}

.services h2{
    font-size:40px;
    margin-bottom:40px;
    color:#00a86b;
}

.service-boxes{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:25px;
}

.box{
    background:#f9f9f9;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 15px rgba(0,0,0,0.1);
    transition:0.3s;
}

.box:hover{
    transform:translateY(-10px);
}

.box img{
    width:100%;
    height:200px;
    object-fit:cover;
    border-radius:10px;
    margin-bottom:15px;
}

.box h3{
    margin-bottom:15px;
    color:#00a86b;
}

/* BOOKING FORM */
.booking{
    padding:70px 20px;
    background:#eafdf5;
}

.booking h2{
    text-align:center;
    margin-bottom:30px;
    font-size:40px;
    color:#00a86b;
}

form{
    max-width:700px;
    margin:auto;
    background:#fff;
    padding:35px;
    border-radius:20px;
    box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

.input-group{
    margin-bottom:20px;
}

.input-group label{
    display:block;
    margin-bottom:8px;
    font-weight:bold;
}

.input-group input,
.input-group textarea,
.input-group select{
    width:100%;
    padding:14px;
    border:1px solid #ccc;
    border-radius:10px;
    font-size:16px;
}

textarea{
    resize:none;
    height:120px;
}

.submit-btn{
    width:100%;
    padding:15px;
    background:#00a86b;
    color:#fff;
    border:none;
    border-radius:10px;
    font-size:20px;
    cursor:pointer;
    transition:0.3s;
}

.submit-btn:hover{
    background:#008f5b;
}

/* CONTACT */
.contact{
    padding:60px 20px;
    text-align:center;
    background:#111;
    color:#fff;
}

.contact h2{
    margin-bottom:20px;
    color:#00ffae;
}

.contact p{
    margin:10px 0;
    font-size:18px;
}

footer{
    background:#000;
    color:#aaa;
    text-align:center;
    padding:15px;
}

/* RESPONSIVE */
@media(max-width:768px){
    .hero-content h1{
        font-size:40px;
    }

    .hero-content h2{
        font-size:22px;
    }

    .hero-content p{
        font-size:17px;
    }
}
</style>
</head>

<body>

<!-- HERO -->
<section class="hero">
    <div class="hero-content">
        <h1>☘️ LUCKY TOURS 🚕</h1>
        <h2>SAFE | FAST | LUCKY</h2>

        <p>
            🏝️ Island Wide Tours <br>
            💒 Wedding Hires <br>
            ✨ Customise Tours <br>
            ✈️ Airport Transfers 24/7 <br>
            🚕 City Cabs & Long Distance
        </p>

        <a href="#booking" class="btn">BOOK NOW</a>
    </div>
</section>

<!-- SERVICES -->
<section class="services">

    <h2>Our Services</h2>

    <div class="service-boxes">

        <div class="box">
            <img src="https://images.unsplash.com/photo-1527631746610-bca00a040d60?q=80&w=1200&auto=format&fit=crop">
            <h3>Island Wide Tours</h3>
            <p>Travel across Sri Lanka with comfort and safety.</p>
        </div>

        <div class="box">
            <img src="https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1200&auto=format&fit=crop">
            <h3>Wedding Hires</h3>
            <p>Luxury vehicles for weddings and special events.</p>
        </div>

        <div class="box">
            <img src="https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=1200&auto=format&fit=crop">
            <h3>Airport Transfers</h3>
            <p>24/7 airport pickup and drop services.</p>
        </div>

    </div>
</section>

<!-- BOOKING -->
<section class="booking" id="booking">

    <h2>Book Your Tour</h2>

    <!-- FORM -->
    <form action="https://formsubmit.co/luckytours.iw@gmail.com" method="POST">

        <!-- Disable Captcha -->
        <input type="hidden" name="_captcha" value="false">

        <!-- Success Message -->
        <input type="hidden" name="_next" value="https://yourwebsite.com/thankyou.html">

        <div class="input-group">
            <label>Full Name</label>
            <input type="text" name="Name" required>
        </div>

        <div class="input-group">
            <label>Phone Number</label>
            <input type="tel" name="Phone" required>
        </div>

        <div class="input-group">
            <label>Email Address</label>
            <input type="email" name="Email">
        </div>

        <div class="input-group">
            <label>Select Service</label>

            <select name="Service">
                <option>Island Wide Tour</option>
                <option>Wedding Hire</option>
                <option>Airport Transfer</option>
                <option>City Cab</option>
                <option>Long Distance</option>
            </select>
        </div>

        <div class="input-group">
            <label>Pickup Location</label>
            <input type="text" name="Pickup Location">
        </div>

        <div class="input-group">
            <label>Date</label>
            <input type="date" name="Date">
        </div>

        <div class="input-group">
            <label>More Details</label>
            <textarea name="Message"></textarea>
        </div>

        <button class="submit-btn" type="submit">
            Submit Booking
        </button>

    </form>

</section>

<!-- CONTACT -->
<section class="contact">

    <h2>Contact Us</h2>

    <p>📞 Call: 009471 921 0238</p>
    <p>💬 WhatsApp: 009471 921 0238</p>
    <p>📩 Email: luckytours.iw@gmail.com</p>

    <br>

    <h3>"Your Lucky Journey Starts Here"</h3>

</section>

<footer>
    © 2026 Lucky Tours | All Rights Reserved
</footer>

</body>
</html>
